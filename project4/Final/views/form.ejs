<html>
  <head>
    <title>Test form</title>
  </head>
  <body>
    <h1>It works!</h1>
    <form action="/post" method="POST">
      <textarea name="text" placeholder="Say something"></textarea>
      <input type="submit" value="Save">
    </form>

    <div class="posts">
      <% if (posts && posts.length) { %>
        <% for (let post of posts) { %>
          <div class="post">
            <span><%= post.date %></span>
            <p><%= post.text %></p>
          </div>
        <% } %>
      <% } else { %>
        <p>No posts yet.</p>
      <% } %>
    </div>
  </body>
</html>
