<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>A Late Night Campfire</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body oncontextmenu="return false;">
  <div id="titleScreen">
    <div id="titleText">A Late Night Campfire</div>
    <div id="titleSub">Click anywhere to begin</div>
  </div>

  <div id="stickmanContainer">
    <pre id="stickmanArt"></pre>
  </div>

  <div id="oldManContainer">
    <pre id="oldManArt"></pre>
  </div>

  <div id="narrationArea">
    <div id="narrationText"></div>
  </div>

  <div id="dialogArea">
    <div id="historyViewport">
      <div id="historySpacer"></div>
      <div id="historyList"></div>
    </div>

    <div id="currentWrapper">
      <div id="currentLine"></div>
    </div>
  </div>

  <div id="choiceArea">
    <div id="choiceButtons"></div>
  </div>

  <div id="fireContainer">
    <pre id="fireAscii"></pre>
    <div id="fireControls">
      <button id="fireStageButton">Next fire stage</button>
      <div id="fireStageLabel"></div>
    </div>
  </div>

  <div id="fireHint">Click the logs to light a campfire.</div>

  <div id="logClickArea"></div>

  <script src="/fire_frame.js"></script>
  <script src="/main.js"></script>
</body>
</html>
